# Copy to /etc/nexora-runtime/node.json and set owner nexora-runtime: mode 0600.
{
  "control_plane_url": "https://api.nexoraedge.digital",
  "node_identity": "REPLACE_WITH_ENROLLED_APPLICATION_NODE_IDENTITY",
  "private_key_file": "/etc/nexora-runtime/node-ed25519.key",
  "state_file": "/var/lib/nexora-runtime/runtime.json",
  "allowed_registries": ["registry.nexoraedge.digital"],
  "poll_interval_seconds": 30
}

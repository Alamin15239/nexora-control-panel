[Unit]
Description=Nexora isolated static artifact publisher
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=nexora-runtime
# Nginx reads publisher-created release trees through www-data. Keep that as
# the primary group so newly created directories inherit the serving group.
Group=www-data
# The broker socket is root:nexora-static; this group grants only IPC access.
SupplementaryGroups=nexora-static
ExecStart=/usr/local/bin/nexora-static-publisher --config /etc/nexora-static-publisher/node.json
Restart=on-failure
RestartSec=5
UMask=0027
NoNewPrivileges=true
PrivateTmp=true
PrivateDevices=true
ProtectSystem=strict
ProtectHome=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
LockPersonality=true
MemoryDenyWriteExecute=true
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
ReadWritePaths=/var/lib/nexora-static
ReadOnlyPaths=/etc/nexora-static-publisher

[Install]
WantedBy=multi-user.target
